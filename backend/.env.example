# APPLICATION
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# DATABASE (PostgreSQL)
# Local Docker: postgresql://postgres:password123@localhost:5432/wedding_db
DATABASE_URL=postgresql://postgres:password123@localhost:5432/wedding_db

# JWT AUTHENTICATION
JWT_SECRET=super_secret_wedding_jwt_key_change_in_production_2026
JWT_EXPIRATION=7d

# S3 STORAGE (Local MinIO or Cloudflare R2)
# Local MinIO default credentials:
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=wedding-receipts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
